NODE_ENV=development
PORT=3000
# Optional since M52: the /setup wizard manages the public URL; a value here overrides it.
APP_URL=http://localhost:3000
# Optional since M52: generated on first boot and persisted on the data volume when unset
# (data/media/.stream247-app-secret); a value here overrides and pins it.
APP_SECRET=change-me
POSTGRES_DB=stream247
POSTGRES_USER=stream247
POSTGRES_PASSWORD=change-me
# Use pinned version tags in production. Keep latest for evaluation only.
STREAM247_WEB_IMAGE=ghcr.io/drjakeberg/stream247-web:latest
STREAM247_WORKER_IMAGE=ghcr.io/drjakeberg/stream247-worker:latest
STREAM247_PLAYOUT_IMAGE=ghcr.io/drjakeberg/stream247-playout:latest
STREAM247_RELAY_IMAGE=bluenviron/mediamtx:1.15.4
DATABASE_URL=postgresql://stream247:change-me@postgres:5432/stream247
CHANNEL_TIMEZONE=UTC
MEDIA_LIBRARY_ROOT=/app/data/media
STREAM247_RELAY_ENABLED=1
STREAM247_RELAY_OUTPUT_URL=rtmp://relay:1935/live/program
STREAM247_RELAY_INPUT_URL=rtmp://relay:1935/live/program
STREAM247_UPLINK_INPUT_MODE=hls
STREAM247_PROGRAM_FEED_DIR=/app/data/media/.stream247-program-feed
STREAM247_PROGRAM_FEED_TARGET_SECONDS=2
STREAM247_PROGRAM_FEED_LIST_SIZE=30
STREAM247_PROGRAM_FEED_FAILOVER_SECONDS=10
STREAM247_PLAYOUT_TRANSIENT_GRACE_SECONDS=20
STREAM_OUTPUT_WIDTH=1280
STREAM_OUTPUT_HEIGHT=720
STREAM_OUTPUT_FPS=30
STREAM_SCALE_ENABLED=1
STREAM_CHAT_OVERLAY_ENABLED=0
STREAM_ALERTS_ENABLED=0
SCENE_RENDERER_ENABLED=1
TWITCH_EVENTSUB_SECRET=
TWITCH_SCHEDULE_SYNC_ENABLED=1
TWITCH_VOD_CACHE_ENABLED=1
TWITCH_VOD_CACHE_ALLOW_REMOTE_FALLBACK=0
TWITCH_VOD_CACHE_DOWNLOAD_TIMEOUT_SECONDS=8
TWITCH_VOD_CACHE_RETENTION_HOURS=72
TWITCH_VOD_CACHE_PARTIAL_MAX_AGE_HOURS=6
# Largest single VOD worth caching. Above this the channel streams it from Twitch instead of
# downloading something that would only be evicted before it finished.
TWITCH_VOD_CACHE_MAX_ASSET_BYTES=21474836480
TWITCH_VOD_CACHE_MAX_BYTES=21474836480
TWITCH_VOD_CACHE_MIN_FREE_BYTES=16106127360
# Bandwidth ceiling for cache downloads in yt-dlp notation (e.g. 8M); empty or 0 means unlimited.
# Unbounded, a background download will take the whole line from the live uplink.
TWITCH_VOD_CACHE_LIMIT_RATE=

# Global disk watermark for the media volume, above the per-cache guardrails. Below the trigger
# (percent free) the worker evicts in stages — unused VOD cache, orphaned feed segments, oldest
# thumbnails — and stops once free space is back above the recovery watermark. Media the schedule
# still references is never touched. Recovery must sit above the trigger or both fall back to
# their defaults.
STREAM247_DISK_WATERMARK_ENABLED=1
STREAM247_DISK_WATERMARK_TRIGGER_PERCENT=10
STREAM247_DISK_WATERMARK_RECOVER_PERCENT=15

# The uplink is restarted when ffmpeg stops advancing its output timestamp while still running.
UPLINK_STALL_TIMEOUT_MS=45000
UPLINK_STALL_GRACE_MS=60000
# An uplink that never encodes a frame is restarted after this long. Below it, a slow RTMP connect
# looks identical; above it, no benign explanation is left.
UPLINK_NO_PROGRESS_RESTART_MS=300000

# The playout is restarted when its feed carries video without audio for this long. A source that
# runs out does not stop ffmpeg: the fps filter keeps duplicating the last frame, so video alone
# never proves anything is still playing. Audio cannot be duplicated.
PLAYOUT_FEED_SILENCE_MS=90000
PLAYOUT_FEED_GRACE_MS=60000
TWITCH_VOD_CACHE_FAILURE_COOLDOWN_SECONDS=1800
# Chapter backfill: per cycle, up to this many chapterless assets from YouTube, Twitch archive and
# direct-media sources get one metadata-only probe (yt-dlp / ffprobe, no download). 0 disables it.
# A failed probe waits out the failure cooldown. A probe that came back valid but empty is trusted
# for the recheck interval and then asked once more, because a rate limit, a geo/subscriber-only
# variant and a broken extractor all answer "no chapters" too. 0 disables rechecks.
CHAPTER_BACKFILL_PER_CYCLE=3
CHAPTER_BACKFILL_FAILURE_COOLDOWN_SECONDS=1800
CHAPTER_BACKFILL_EMPTY_RECHECK_SECONDS=604800
STREAM_OUTPUT_URL=
STREAM_OUTPUT_KEY=
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
TWITCH_STREAM_KEY=
FFMPEG_BIN=ffmpeg
FFMPEG_PRESET=veryfast
FFMPEG_MAXRATE=4500k
FFMPEG_BUFSIZE=9000k
FFMPEG_AUDIO_BITRATE=160k
PLAYOUT_RECONNECT_HOURS=48
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_DEFAULT_CATEGORY_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
